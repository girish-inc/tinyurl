    "@tailwindcss/vite": "^4.1.17",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "nanoid": "^5.1.6",
    "tailwindcss": "^4.1.17",
    "vite": "^7.2.4"
  }
